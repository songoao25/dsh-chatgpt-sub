{
  "name": "dsh-chatgpt-sub",
  "version": "0.5.1",
  "description": "Sign in with your ChatGPT account to use ChatGPT models in DSH.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "chatgpt",
    "codex",
    "subscription",
    "oauth",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/SONGOAO25/dsh-chatgpt-sub.git"
  },
  "homepage": "https://github.com/SONGOAO25/dsh-chatgpt-sub",
  "author": "SONGOAO25",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "docs/INSTALL.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build",
    "test": "node tests/run-all.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "react": "^18.0.0"
  }
}
